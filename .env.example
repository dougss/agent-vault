# Agent Vault — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit the .env file

# === OpenClaw ===
OPENAI_API_KEY=sk-proj-your-key-here
GEMINI_API_KEY=AIzaSy-your-key-here
MOONSHOT_API_KEY=sk-your-key-here
BRAVE_API_KEY=BSA-your-key-here
DASHSCOPE_API_KEY=sk-your-key-here
BAILIAN_API_KEY=sk-sp-your-key-here

# === OpenClaw Gateway ===
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here
OPENCLAW_GATEWAY_PORT=18789

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# === Databases ===
LIFE_OS_DB_HOST=127.0.0.1
LIFE_OS_DB_PORT=5432
LIFE_OS_DB_USER=life_os
LIFE_OS_DB_PASS=your-password-here
LIFE_OS_DB_NAME=life_os

FINAI_DB_HOST=127.0.0.1
FINAI_DB_PORT=5433
FINAI_DB_USER=postgres
FINAI_DB_PASS=your-password-here
FINAI_USER_ID=your-user-uuid-here

# === Miniflux ===
MINIFLUX_URL=http://127.0.0.1:8081
MINIFLUX_API_KEY=your-miniflux-api-key-here

# === Slack (Harness) ===
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_APP_TOKEN=xapp-your-token-here
SLACK_USER_ID=your-slack-user-id-here

# === Server ===
SERVER_IP=192.168.1.100
SERVER_USER=macmini
